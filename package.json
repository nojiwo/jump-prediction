{
  "name": "jump-prediction-pwa",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json && vite build",
    "preview": "vite preview",
    "test:core": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "python3 tests/db_test.py",
    "test:server": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test": "npm run typecheck:core && npm run test:core && npm run test:db && npm run test:server"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
